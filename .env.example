# --- REQUIRED IN PRODUCTION -------------------------------------------------
# Postgres connection string. On Supabase: Project Settings → Database → Connection string
# → "Transaction pooler" (port 6543) URI. Server-side only — never exposed to browsers.
DATABASE_URL=postgresql://postgres.xxxxxxxx:YOUR-DB-PASSWORD@aws-0-us-west-1.pooler.supabase.com:6543/postgres

# --- CLASSROOM ROSTER (optional; defaults shown) -----------------------------
# The final leaderboard is revealed automatically once GROUP_COUNT × GROUP_CAPACITY divers have
# joined AND finished. Match these to the number of students actually playing.
GROUP_COUNT=4
GROUP_CAPACITY=4
QUESTION_SECONDS=25
# If a member of a full group never presses Start, their clock starts after this many seconds
# so one idle phone cannot block the reveal. 0 disables.
AUTO_START_SECONDS=300
# A finished game is replaced by a fresh one after N minutes; an idle unfinished game after M minutes.
RESET_AFTER_REVEAL_MINUTES=60
IDLE_RESET_MINUTES=180

# --- LOCAL DEVELOPMENT ONLY ------------------------------------------------
# Leave DATABASE_URL unset locally to use the embedded PGlite database in ./.data.
# PGLITE_DIR=memory   # throwaway in-memory database
