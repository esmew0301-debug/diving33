# --- REQUIRED IN PRODUCTION -------------------------------------------------
# Postgres connection string. On Supabase: Project Settings → Database → Connection string
# → "Transaction pooler" (port 6543) URI. Server-side only — never exposed to browsers.
DATABASE_URL=postgresql://postgres.xxxxxxxx:YOUR-DB-PASSWORD@aws-0-us-west-1.pooler.supabase.com:6543/postgres

# Host password (exact, case-sensitive). Server-side secret: set it in Vercel → Settings →
# Environment Variables. It is never sent to browsers.
HOST_PASSWORD=change-me

# --- CLASSROOM ROSTER (optional; defaults shown) -----------------------------
# The final leaderboard appears on the host screen once ALL GROUP_COUNT groups have started
# and finished. GROUP_CAPACITY is the maximum players per group (a group can start with 1).
GROUP_COUNT=4
GROUP_CAPACITY=4
# An unfinished game with no student activity for this many minutes is replaced by a fresh one.
IDLE_RESET_MINUTES=180

# --- LOCAL DEVELOPMENT / TESTING ONLY (ignored in production builds) ---------
# Leave DATABASE_URL unset locally to use the embedded PGlite database in ./.data.
# PGLITE_DIR=memory              # throwaway in-memory database
# DEV_REVEAL_STARTED_GROUPS=1    # reveal results once every STARTED group finishes (solo reveal test)
# ENABLE_TEST_HOOKS=1            # /api/dev/clock for automated timing tests
